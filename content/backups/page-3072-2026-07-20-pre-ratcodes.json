"elType":"widget","settings":{"icon_list":[{"text":"Environmentally Friendly","selected_icon":{"value":"fas fa-check-square","library":"fa-solid"},"_id":"c40b2f6"}],"icon_align":"start","icon_color":"#75C6C1","icon_size":{"unit":"px","size":22,"sizes":[]},"icon_self_align":"left","icon_self_vertical_align":"center","icon_typography_typography":"custom","icon_typography_font_family":"Inter","icon_typography_font_size":{"unit":"px","size":14,"sizes":[]},"icon_typography_font_weight":"500","icon_typography_line_height":{"unit":"px","size":20,"sizes":[]},"text_color":"#666666","space_between":{"unit":"px","size":0,"sizes":[]},"_margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"_padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true},"icon_size_mobile":{"unit":"px","size":20,"sizes":[]},"icon_typography_font_size_mobile":{"unit":"px","size":12,"sizes":[]}},"elements":[],"widgetType":"icon-list"}],"isInner":true}],"isInner":true}],"isInner":true}],"isInner":false},{"id":"d34c225","elType":"container","settings":{"boxed_width":{"unit":"px","size":1400,"sizes":[]},"padding":{"unit":"px","top":"40","right":"40","bottom":"80","left":"40","isLinked":false},"flex_direction":"row","flex_justify_content":"center","flex_align_items":"flex-start","flex_gap":{"unit":"px","size":0,"column":"0","row":"0"},"background_background":"classic","background_color":"#FFFFFF","background_color_stop":{"unit":"%","size":20,"sizes":[]},"background_color_b":"#010A1180","background_color_b_stop":{"unit":"%","size":50,"sizes":[]},"background_image":{"url":"","id":"","size":"","alt":"","source":"library"},"background_position":"center center","background_size":"cover","background_overlay_background":"classic","background_overlay_color_stop":{"unit":"%","size":50,"sizes":[]},"background_overlay_color_b":"#010A11E5","background_overlay_color_b_stop":{"unit":"%","size":90,"sizes":[]},"background_overlay_gradient_angle":{"unit":"deg","size":270,"sizes":[]},"background_overlay_opacity":{"unit":"px","size":1,"sizes":[]},"margin":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":false},"padding_mobile":{"unit":"px","top":"20","right":"20","bottom":"40","left":"20","isLinked":false},"css_classes":"box-bg"},"elements":[{"id":"6a7e026","elType":"container","settings":{"content_width":"full","padding":{"unit":"px","top":"0","right":"0","bottom":"0","left":"0","isLinked":true}},"elements":[{"id":"5de1788","elType":"widget","settings":{"html":"<div class=\"bdg-widget\" id=\"bdg-widget\">\n\n  <div class=\"bdg-image-col\">\n    <img id=\"bdg-product-img\" src=\"\" alt=\"Bedding product\" />\n  </div>\n\n  <div class=\"bdg-tabs-col\">\n\n    <div class=\"bdg-prod-tabs\">\n      <button class=\"bdg-prod-tab active\" data-panel=\"alphadri\">Alpha Dri</button>\n      <button class=\"bdg-prod-tab\"        data-panel=\"alphadriplus\">Alpha Dri+</button>\n      <button class=\"bdg-prod-tab\"        data-panel=\"corncob\">Corn Cob</button>\n      <button class=\"bdg-prod-tab\"        data-panel=\"safe\">SAFE</button>\n    </div>\n\n    <div class=\"bdg-panel active\" id=\"panel-alphadri\">\n      <h2 class=\"bdg-product-name\">ALPHA-Dri</h2>\n      <p class=\"bdg-product-desc\">\n        ALPHA-Dri bedding is ideal for GLP research. Standard disposable mouse cage bottom\n        arrives pre-bedded and ready for use with ALPHA-Dri. Perfect for GLP studies.\n      </p>\n      <ul class=\"bdg-codes-list\">\n        <li>M-BTM-AD (Pre-bedded, ALPHA-Dri)</li>\n        <li>M-BTM-ADE (Pre-bedded, ALPHA-Dri with 3-ply Innorichment)</li>\n        <li>M-BTM-ADE-1 (Pre-bedded, ALPHA-Dri with 1-ply Innorichment)</li>\n      </ul>\n      <p class=\"bdg-advantages-title\">Key Advantages:</p>\n      <ul class=\"bdg-advantages-list\">\n        <li><strong>Dust elimination:</strong> Clean and virtually dustless bedding helps reduce cross-contamination, filter clogging, and possible issues of dust adherence to animals.</li>\n        <li><strong>Better for animal observation:</strong> Bright, white color aids in animal observation.</li>\n        <li>Exceptional absorbency.</li>\n        <li>Environmentally friendly.</li>\n        <li>Delivered irradiated.</li>\n      </ul>\n    </div>\n\n    <div class=\"bdg-panel\" id=\"panel-alphadriplus\">\n      <h2 class=\"bdg-product-name\">ALPHA-Dri+</h2>\n      <p class=\"bdg-product-desc\">\n        Mouse cage bottom for use with Innovive IVC or static mouse lids, prefilled with ALPHA-Dri+\n        bedding. ALPHA-Dri+ is both bedding and nesting materials combined in one. Mini-rolls of\n        multi-layered virgin paper cut into short lengths are added to ALPHA-Dri to give the animals\n        nesting material that enhances their nest-building instincts.\n      </p>\n      <ul class=\"bdg-codes-list\">\n        <li>M-BTM-AD+ (Pre-bedded, ALPHA-Dri+)</li>\n        <li>M-BTM-AD+E1 (Pre-bedded, ALPHA-Dri+ with 1-ply Innorichment)</li>\n      </ul>\n      <p class=\"bdg-advantages-title\">Key Advantages:</p>\n      <ul class=\"bdg-advantages-list\">\n        <li><strong>Dust elimination:</strong> Clean and virtually dustless bedding helps reduce cross-contamination, filter clogging, and possible issues of dust adherence to animals.</li>\n        <li><strong>Better for animal observation:</strong> Bright, white color aids in animal observation.</li>\n        <li>Exceptional absorbency.</li>\n        <li>Environmentally friendly.</li>\n        <li>Delivered irradiated.</li>\n      </ul>\n    </div>\n\n    <div class=\"bdg-panel\" id=\"panel-corncob\">\n      <h2 class=\"bdg-product-name\">Corn Cob</h2>\n      <p class=\"bdg-product-desc\">\n        Corn Cob is proven to encapsulate the urea crystals found in animal urine, controlling\n        ammonia levels. Its sponge-like characteristics encapsulate ammonia and trap associated odors.\n      </p>\n      <ul class=\"bdg-codes-list\">\n        <li>M-BTM-C4 (Pre-bedded, Corn Cob)</li>\n        <li>M-BTM-C4E (Pre-bedded, Corn Cob with 3-ply Innorichment)</li>\n        <li>M-BTM-C4E-1 (Pre-bedded, Corn Cob with 1-ply Innorichment)</li>\n        <li>M-BTM-C8 (Pre-bedded, Corn Cob)</li>\n        <li>M-BTM-C8E (Pre-bedded, Corn Cob with 3-ply Innorichment)</li>\n        <li>M-BTM-C8E-1 (Pre-bedded, Corn Cob with 1-ply Innorichment)</li>\n      </ul>\n      <p class=\"bdg-advantages-title\">Key Advantages:</p>\n      <ul class=\"bdg-advantages-list\">\n        <li>Will not cling to animals or cages.</li>\n        <li>Fast-wicking absorption.</li>\n        <li>Resistant to cage flooding from water bottle drip.</li>\n        <li>Perfect for isolator and IVC cages.</li>\n        <li>Environmentally friendly.</li>\n        <li>Available in 1/4 in (C4) and 1/8 in (C8) sizes.</li>\n        <li>Delivered irradiated.</li>\n      </ul>\n    </div>\n\n    <div class=\"bdg-panel\" id=\"panel-safe\">\n      <h2 class=\"bdg-product-name\">SAFE (Biofresh)</h2>\n      <p class=\"bdg-product-desc\">\n        Mouse cage bottom for use with Innovive IVC or static mouse lids, prefilled with SAFE bedding.\n      </p>\n      <ul class=\"bdg-codes-list\">\n        <li>M-BTM-EP (Mouse bottom pre-bedded with SAFE)</li>\n      </ul>\n      <p class=\"bdg-advantages-title\">Key Advantages:</p>\n      <ul class=\"bdg-advantages-list\">\n        <li>Excellent absorbency and ammonia control.</li>\n        <li>Improve the welfare of animals with soft, absorbent, and comfortable bedding.</li>\n        <li>Helps alleviate animals' stress with easier clean-up and longer changeout intervals.</li>\n        <li>Aids in a cleaner and healthier environment for research.</li>\n        <li>Environmentally friendly.</li>\n        <li>Delivered irradiated.</li>\n      </ul>\n    </div>\n\n  </div>\n</div>\n<script>\n(function () {\n  var imageMap = {\n    'alphadri':     'https://innovive.com/wp-content/uploads/2026/06/ALPHA-Dri.png',\n    'alphadriplus': 'https://innovive.com/wp-content/uploads/2026/06/Alpha-Dri-1.png',\n    'corncob':      'https://innovive.com/wp-content/uploads/2026/06/Corn-Cob.png',\n    'safe':         'https://innovive.com/wp-content/uploads/2026/06/SAFE.png',\n  };\n\n  function init() {\n    var img    = document.getElementById('bdg-product-img');\n    var tabs   = document.querySelectorAll('.bdg-prod-tab');\n    var panels = document.querySelectorAll('.bdg-panel');\n\n    if (!img || !tabs.length) return;\n\n    function setImage(panelId) {\n      var src = imageMap[panelId];\n      if (!src) return;\n      img.style.opacity = '0';\n      setTimeout(function () {\n        img.src = src;\n        img.alt = panelId;\n        img.style.opacity = '1';\n      }, 180);\n    }\n\n    function activatePanel(panelId) {\n      panels.forEach(function (p) { p.classList.remove('active'); });\n      var target = document.getElementById('panel-' + panelId);\n      if (target) {\n        target.classList.add('active');\n        setImage(panelId);\n      }\n    }\n\n    tabs.forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        tabs.forEach(function (b) { b.classList.remove('active'); });\n        btn.classList.add('active');\n        activatePanel(btn.dataset.panel);\n      });\n    });\n\n    activatePanel('alphadri');\n  }\n\n  if (document.readyState === 'loading') {\n    document.addEventListener('DOMContentLoaded', init);\n  } else {\n    init();\n  }\n})();\n</script>","custom_css":"@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');\n\n.bdg-widget {\n  background: transparent;\n  display: flex;\n  flex-direction: row;\n  align-items: ;\n  gap: 24px;\n  width: 100%;\n  max-width: 1400px;\n  box-sizing: border-box;\n}\n\n.bdg-image-col {\n  flex: 0 0 42%;\n  background: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  border-radius: 12px;\n  /*box-shadow: 0px 20px 40px 0px #0F1D280F;*/\n  box-sizing: border-box;\n}\n\n.bdg-image-col img {\n  width: 100%;\n  max-width: 80%;\n  border-radius: 8px;\n  height: auto;\n  object-fit: cover;\n  transition: opacity 0.35s ease;\n  display: block;\n}\n\n.bdg-tabs-col {\n  flex: 1 1 58%;\n  padding: 8px 0 0 0;\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n  box-sizing: border-box;\n}\n\n.bdg-prod-tabs {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-bottom: 20px;\n}\n\n.bdg-prod-tab {\n  font-family: 'Inter', sans-serif;\n  background: #FFFFFF;\n  border: 1.5px solid rgba(0, 82, 135, 0.2);\n  border-radius: 6px;\n  outline: none;\n  cursor: pointer;\n  font-size: 14px;\n  font-weight: 500;\n  color: #333333;\n  padding: 8px 20px;\n  transition: background 0.2s, color 0.2s, border-color 0.2s;\n  letter-spacing: 0.01em;\n}\n\n.bdg-prod-tab:hover {\n  border-color: #005287;\n  color: #fff;\n  background: #005287;\n}\n\n.bdg-prod-tab.active {\n  background: #005287;\n  border-color: #005287;\n  color: #FFFFFF;\n}\n\n.bdg-panel {\n  display: none;\n  flex-direction: column;\n  gap: 4px;\n  animation: bdgFadeIn 0.25s ease;\n}\n\n.bdg-panel.active { display: flex; }\n\n@keyframes bdgFadeIn {\n  from { opacity: 0; transform: translateY(4px); }\n  to   { opacity: 1; transform: translateY(0); }\n}\n\n.bdg-product-name {\n  font-family: 'Inter', sans-serif;\n  font-size: 36px;\n  font-weight: 700;\n  color: #00223D;\n  line-height: 1.1;\n  margin: 0 0 8px;\n}\n\n.bdg-product-desc {\n  font-family: 'Inter', sans-serif;\n  font-size: 14.5px;\n  color: #666666;\n  line-height: 1.65;\n  margin: 0 0 12px;\n}\n\n.bdg-codes-list {\n  list-style: none;\n  padding: 0;\n  margin: 0 0 12px;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.bdg-codes-list li {\n  font-family: 'Inter', sans-serif;\n  font-size: 14px;\n  color: #666666;\n  padding-left: 18px;\n  position: relative;\n  line-height: 1.5;\n}\n\n.bdg-codes-list li::before {\n  content: '\u2022';\n  position: absolute;\n  left: 0;\n  color: #666666;\n}\n\n.bdg-advantages-title {\n  font