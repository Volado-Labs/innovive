 "width_mobile": {"unit": "%", "size": "", "sizes": []}, "boxed_width": {"unit": "%", "size": 60, "sizes": []}, "boxed_width_tablet": {"unit": "%", "size": "", "sizes": []}, "boxed_width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_align_items": "center"}, "elements": [{"id": "6a3edf8", "elType": "widget", "settings": {"text": "FAQs", "selected_icon": {"value": {"url": "http://inno.myvoladolabs.com/wp-content/uploads/2026/05/Background-1.svg", "id": 569}, "library": "svg"}, "icon_indent": {"unit": "px", "size": 6, "sizes": []}, "align": "left", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 12, "sizes": []}, "typography_font_weight": "500", "typography_line_height": {"unit": "px", "size": 16, "sizes": []}, "typography_letter_spacing": {"unit": "px", "size": 0.6, "sizes": []}, "button_text_color": "#005287", "background_color": "#E4F1F9", "border_radius": {"unit": "px", "top": "4", "right": "4", "bottom": "4", "left": "4", "isLinked": true}, "text_padding": {"unit": "px", "top": "6", "right": "16", "bottom": "6", "left": "16", "isLinked": false}, "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [], "widgetType": "button"}, {"id": "21521f1", "elType": "widget", "settings": {"title": "Frequently Asked Questions", "typography_typography": "custom", "typography_font_family": "Inter", "typography_font_size": {"unit": "px", "size": 40, "sizes": []}, "typography_font_weight": "700", "typography_line_height": {"unit": "px", "size": 48, "sizes": []}, "typography_letter_spacing": {"unit": "px", "size": -1.2, "sizes": []}, "title_color": "#00223D", "_margin": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "_padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}, "_element_width": "inherit", "_element_custom_width": {"unit": "px", "size": 856, "sizes": []}, "typography_font_size_mobile": {"unit": "px", "size": 30, "sizes": []}, "typography_line_height_mobile": {"unit": "em", "size": 1.2, "sizes": []}, "align": "center"}, "elements": [], "widgetType": "heading"}, {"id": "b52bec1", "elType": "widget", "widgetType": "nested-tabs", "settings": {"tabs": [{"tab_title": "Caging", "_id": "b20625e"}, {"tab_title": "Racks", "_id": "0ce20fa"}, {"tab_title": "Water", "_id": "6852042"}, {"_id": "640250c", "tab_title": "Recycling"}], "tabs_direction": "block-start", "tabs_direction_mobile": "block-start", "tabs_justify_horizontal": "center", "tabs_justify_horizontal_mobile": "start", "tabs_justify_vertical_mobile": "start", "title_alignment_mobile": "start", "horizontal_scroll_mobile": "disable", "breakpoint_selector": "none", "tabs_title_space_between": {"unit": "px", "size": 12, "sizes": []}, "tabs_title_spacing": {"unit": "px", "size": 40, "sizes": []}, "tabs_title_background_color_background": "classic", "tabs_title_background_color_color": "#FFFFFF", "tabs_title_background_color_hover_color": "#005287", "tabs_title_transition_duration": {"unit": "px", "size": 0.6, "sizes": []}, "tabs_title_background_color_active_color": "#005287", "tabs_title_border_radius": {"unit": "px", "top": "8", "right": "8", "bottom": "8", "left": "8", "isLinked": true}, "padding": {"unit": "px", "top": "10", "right": "20", "bottom": "10", "left": "20", "isLinked": false}, "title_typography_typography": "custom", "title_typography_font_family": "Inter", "title_typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "title_typography_font_weight": "500", "title_text_color": "#005287", "title_text_color_hover": "#FFFFFF", "title_text_color_active": "#FFFFFF", "_margin": {"unit": "px", "top": "40", "right": "0", "bottom": "0", "left": "0", "isLinked": false}}, "elements": [{"id": "5dc0bc8", "elType": "container", "settings": {"_title": "Tab #1", "content_width": "full", "width": {"unit": "%", "size": 100, "sizes": []}, "flex_direction": "row", "flex_direction_tablet": "column", "flex_gap": {"column": "", "row": "", "isLinked": true, "unit": "px", "size": null}, "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "06dcd3f", "elType": "container", "settings": {"content_width": "full", "flex_direction": "row", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "da6f148", "elType": "widget", "settings": {"tabs": [{"_id": "08a36dc", "tab_title": "How many mice can be housed in an Innocage\u00ae Mouse?", "tab_content": "<p>The Innocage\u00ae Mouse is sized for 5 mice. It provides 5 inches (12.7 cm) of headroom and over 81 in\u00b2 (530 cm\u00b2) of floor space. The amount of floor space in an Innovive cage exceeds what is recommended for 5 mice in the US Guide for the Care and Use of Laboratory Animals. It also complies with the European Type II long caging specification.</p>"}, {"_id": "ac60618", "tab_title": "What is the recommended cage change interval for Innocage\u00ae IVC Mouse and Rat cages?", "tab_content": "<p id=\"viewer-2vqu1\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\">For Innocage\u00ae IVC Mouse, most users perform cage changes every 14 days. Some have extended beyond 14 days when there are less than 5 mice in the cage.</span></p><p id=\"viewer-4d3sl\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\">For Innocage\u00ae IVC Rat, most users perform cage changes every 7-10 days.</span></p>"}, {"_id": "8ef1297", "tab_title": "How much recycled plastic is used in an Innocage\u00ae bottom?", "tab_content": "<p>As part of a continued effort to improve sustainable practices, Innocage\u00ae bottoms are made with up to 30% post-consumer recycled plastic. The recycled plastic is melted and thermoformed in high heat, and then the resulting Innocage bottoms are fully irradiated to ensure that it has zero bioload.</p>"}, {"_id": "940c7f0", "tab_title": "What is the shelf life for caging supplies?", "tab_content": "<p>The shelf life for caging supplies is 1 year when kept in original packaging and in good storage conditions (dry environment under 115\u00b0F/46\u00b0C).</p>"}, {"_id": "68af26d", "tab_title": "Can the cages be autoclaved?", "tab_content": "<p>Used cages can be autoclaved for decontamination purposes. Please consult with your Innovive representative for the decontamination protocol.</p>"}, {"_id": "e46120c", "tab_title": "What does it mean when caging is Research-Ready?", "tab_content": "<p>Research-Ready means that all Innovive products arrive securely double-bagged and irradiated, and are ready for research use.</p>"}, {"_id": "b062980", "tab_title": "What type of filter paper is in your cage?", "tab_content": "<p>Innovive IVC cages utilize Reemay\u00ae filter paper. Innovive static cages utilize Uniblend filter paper.</p>"}, {"_id": "469a335", "tab_title": "How much bedding is used in each cage?", "tab_content": "<p id=\"viewer-atf0a\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\">M-BTM-C8/C8E \u2013 450 cm\u00b3</span></p><p id=\"viewer-irgr\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\">M-BTM-AD \u2013 450 cm\u00b3</span></p><p id=\"viewer-v9c0\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\">R-BTM-C8 \u2013 850 cm\u00b3</span></p><p id=\"viewer-a012m\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\">R-BTM-AD \u2013 850 cm\u00b3</span></p>"}, {"_id": "a284393", "tab_title": "What is the weight capacity of the mouse feeder (M-FEED) to the fill line?", "tab_content": "<p>The M-FEED can hold approximately 360 grams of unautoclaved, standard pelleted rodent diet. The weight of food can vary based on factors such as the type of food pellet, ingredient composition, and environmental factors.</p>"}, {"tab_title": "How must I process the cages for local recycling?", "tab_content": "<p id=\"viewer-atf0a\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\"><strong>Bottoms</strong>: PET1; Must be free of animal bedding. </span></p><p id=\"viewer-8tstq\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\"><strong>Lids:</strong> PET1, Paper; No separation required (grates are PET 1 and paper dissolves)</span></p><p id=\"viewer-fc1bg\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\"><strong>Water Bottles</strong>: PET1 HDP; Bottles and caps accepted \u2013 some require an empty bottle check with recycler. Accepted in all municipal programs.</span></p><p id=\"viewer-appmn\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\"><strong>All Feeders</strong>: PET</span></p><p id=\"viewer-38idg\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\"><span class=\"R-1EE\"><strong>Cage Card Holder</strong>: PET</span></p>", "_id": "f56b503"}, {"tab_title": "How do I prepare the cages for pick up?", "tab_content": "<p id=\"viewer-atf0a\" class=\"dUraF _0Jf6a YXSPe\" dir=\"auto\">Users typically pack cage bottoms and lids in the bags they came in. Next place the bags in cardboard gaylords using the packing instructions provided. You can purchase gaylords from <a class=\"CMc5N jZ8Yo\" href=\"http://www.uline.com/\" target=\"_blank\" rel=\"noopener\" data-hook=\"web-link\">www.uline.com</a> or <a class=\"CMc5N jZ8Yo\" href=\"http://www.cardboardboxes4u.com/\" target=\"_blank\" rel=\"noopener\" data-hook=\"web-link\">www.cardboardboxes4u.com</a> or many other office/warehouse supply companies.</p>", "_id": "b4b7b36"}], "faq_schema": "yes", "border_width": {"unit": "px", "size": 0, "sizes": []}, "border_color": "#F6F9FF", "title_background": "#FFFFFF", "title_color": "#000000", "tab_active_color": "#000000", "title_typography_typography": "custom", "title_typography_font_family": "Inter", "title_typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "title_typography_font_weight": "600", "title_padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "icon_align": "right", "icon_color": "#185337", "icon_active_color": "#185337", "content_background_color": "#FFFFFF", "content_color": "#4A5568", "content_typography_typography": "custom", "content_typography_font_family": "Inter", "content_typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "content_typography_font_weight": "400", "content_padding": {"unit": "px", "top": "0", "right": "30", "bottom": "30", "left": "30", "isLinked": false}}, "elements": [], "widgetType": "accordion"}], "isInner": true}, {"id": "041b4b0", "elType": "container", "settings": {"content_width": "full", "flex_direction": "row", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "9c3ce3f", "elType": "widget", "settings": {"tabs": [{"_id": "08a36dc", "tab_title": "How many rats can be housed in an Innocage\u00ae Rat?", "tab_content": "<p>The Innocage\u00ae Rat is sized for 2 rats. It provides 7 inches (17.8 cm) of headroom and over 140 in\u00b2 (900 cm\u00b2) of floor space. The amount of floor space in an Innovive cage complies with what is recommended for 2 rats (each up to 500g in weight) in US Guide for the Care and Use of Laboratory Animals. It also complies with the European Type III caging specification.</p>"}, {"_id": "ac60618", "tab_title": "What is the recommended cage change interval for Innocage\u00ae Static Mouse and Rat cages?", "tab_content": "<p>For Innocage\u00ae Static Mouse and Rat cages, most users perform a cage change every 5-7 days. It can also be extended beyond 7 days depending on the size and number of animals in the cages.</p>"}, {"_id": "8ef1297", "tab_title": "Why do some Innocage\u00ae bottoms have a different color/hue?", "tab_content": "<p>The mix of recycled plastic can slightly affect the color/hue of the Innocage\u00ae bottom, but will not affect the clarity or quality of the Innocage\u00ae bottom.</p>"}, {"_id": "940c7f0", "tab_title": "What is the proper temperature range for storing cages?", "tab_content": "<p>The temperature for storing Innovive caging components should not exceed 115\u00b0F/46\u00b0C.</p>"}, {"_id": "68af26d", "tab_title": "Can you clean or wash the cages bottoms?", "tab_content": "<p>This is not an intended use for Innovive disposable cages. Reusing cage bottoms introduces the risk of contamination.</p>"}, {"_id": "e46120c", "tab_title": "How can I transport cages from one facility to another?", "tab_content": "<p>Any standard Innovive cage can be used to transfer animals between facilities. We also offer the Innocage\u00ae Mouse Transportation lid that can be used for longer trips that span up to a week in duration.</p>"}, {"_id": "b062980", "tab_title": "What kind of bedding is used in the pre-bedded cages?", "tab_content": "<p>We offer corn cob or ALPHA-dri\u00ae for bedding in our pre-bedded cages. We also offer corn cob bedding enriched with Innorichment\u2122.</p>"}, {"_id": "469a335", "tab_title": "What is the volume of the mouse feeder (M-FEED) to the fill line?", "tab_content": "<p>The exact volume is 34.8in\u00b3. Volume of food will vary on packing density and size of the food pellets.</p>"}, {"_id": "a284393", "tab_title": "How should I clean the rat wire bars?", "tab_content": "<p>Your wire bars can go through a washer, an autoclave or hand wipe/sanitize as you would clean other lab supplies.</p>"}, {"_id": "9745ad4", "tab_title": "When would I use the Innovive Closed-Loop Recycling Service?", "tab_content": "<p>You would use the Innovive Recycling program: 1. If your municipal program does not accept open neck containers: Many municipal programs do not recycle open neck containers as they do not have a Material Sorting Facility. We see this often on the East Coast. Water bottles are universally accepted in all local area programs. Lids and bottoms can then be recycled through the Innovive program for a fee with the added advantage of not having to dump cages. 2. If you do not want to dump cages: Many of our customers opt for the Innovive recycling program as they prefer not to dump bedding from cage bottoms.</p>"}, {"tab_title": "How much recycling storage space do I need?", "tab_content": "<p>Depending on volume and pick-up frequency, most customers dedicate 10'x10' space to store cages to be picked for recycling.</p>", "_id": "8148fa7"}], "border_width": {"unit": "px", "size": 0, "sizes": []}, "border_color": "#F6F9FF", "title_background": "#FFFFFF", "title_color": "#000000", "tab_active_color": "#000000", "title_typography_typography": "custom", "title_typography_font_family": "Inter", "title_typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "title_typography_font_weight": "600", "title_padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "icon_align": "right", "icon_color": "#185337", "icon_active_color": "#185337", "content_background_color": "#FFFFFF", "content_color": "#4A5568", "content_typography_typography": "custom", "content_typography_font_family": "Inter", "content_typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "content_typography_font_weight": "400", "content_padding": {"unit": "px", "top": "0", "right": "30", "bottom": "30", "left": "30", "isLinked": false}}, "elements": [], "widgetType": "accordion"}], "isInner": true}], "isInner": true, "isLocked": true}, {"id": "f0ad84e", "elType": "container", "settings": {"_title": "Tab #2", "content_width": "full", "flex_direction": "row", "flex_direction_tablet": "column"}, "elements": [{"id": "7ccae4b", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 50, "sizes": []}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_direction": "row", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "d796513", "elType": "widget", "settings": {"tabs": [{"_id": "08a36dc", "tab_title": "Does the Innorack\u00ae have special electrical requirements?", "tab_content": "<p>No \u2013 a standard outlet is sufficient. The Innorack\u00ae has a very low power draw, which is similar to a standard light bulb.</p>"}, {"_id": "ac60618", "tab_title": "In the event of power outage, will the rack automatically turn on when power is restored?", "tab_content": "<p>Yes \u2013 the rack will automatically restart with same settings as when the power was cut and return to the settings that had previously been selected.</p>"}, {"_id": "8ef1297", "tab_title": "Are the racks compatible with VHP or other decontamination processes?", "tab_content": "<p>Yes \u2013 VHP and similar technologies can be used to decontaminate the Innorack\u00ae.</p>"}], "faq_schema": "yes", "border_width": {"unit": "px", "size": 0, "sizes": []}, "border_color": "#F6F9FF", "title_background": "#FFFFFF", "title_color": "#000000", "tab_active_color": "#000000", "title_typography_typography": "custom", "title_typography_font_family": "Inter", "title_typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "title_typography_font_weight": "600", "title_padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "icon_align": "right", "icon_color": "#185337", "icon_active_color": "#185337", "content_background_color": "#FFFFFF", "content_color": "#4A5568", "content_typography_typography": "custom", "content_typography_font_family": "Inter", "content_typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "content_typography_font_weight": "400", "content_padding": {"unit": "px", "top": "0", "right": "30", "bottom": "30", "left": "30", "isLinked": false}}, "elements": [], "widgetType": "accordion"}], "isInner": true}, {"id": "593def1", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 50, "sizes": []}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_direction": "row", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "a29e0c5", "elType": "widget", "settings": {"tabs": [{"_id": "08a36dc", "tab_title": "Do the rack have to be connected to a room exhaust system?", "tab_content": "<p>No \u2013 Innoracks\u00ae do not need to be connected to a room exhaust system. Optionally, you can attach a connector between the Innorack\u00ae and the facility's HVAC systems if you would like to direct odor and humidity out of holding rooms.</p>"}, {"_id": "ac60618", "tab_title": "How long can mice and rats remain in the IVC rack/cages if power is lost?", "tab_content": "<p id=\"viewer-atf0a\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">It depends on the total number of animals in the cage, the size of those animals and macro-environmental conditions. For example, 2 mothers in a cage each with weaning age litters will consume more oxygen and produce more CO2 than a cage containing a single animal. For our standard Innocage\u00ae IVC Mouse Single Filter lid, we do not recommend having the cages outside the rack for more than 6 hours as the animals could start to see signs of stress (similar to reusable IVC cages). However in the case of a power failure, the animals will survive for longer periods. With that in mind our guideline for power failure planning is as follows:</span></p><div id=\"viewer-5tk9h\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">\u00a0</span></div><p id=\"viewer-3mble\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">MVX1 \u2013 12-24 hours</span></p><p id=\"viewer-e6au1\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">MVX2 \u2013 12-24+ hours</span></p><p id=\"viewer-2vu0d\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">MVX3 \u2013 6 hours</span></p><p id=\"viewer-7hgul\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">MVX6 \u2013 48+ hours</span></p><div id=\"viewer-87fhj\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">\u00a0</span></div><p id=\"viewer-472dl\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">RVX1 \u2013 12 hours </span></p><p id=\"viewer-d8rl\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">RVX6 \u2013 24+ hours </span></p><p id=\"viewer-g5t8\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">RVX7 \u2013 24+ hours</span></p>"}], "faq_schema": "yes", "border_width": {"unit": "px", "size": 0, "sizes": []}, "border_color": "#F6F9FF", "title_background": "#FFFFFF", "title_color": "#000000", "tab_active_color": "#000000", "title_typography_typography": "custom", "title_typography_font_family": "Inter", "title_typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "title_typography_font_weight": "600", "title_padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "icon_align": "right", "icon_color": "#185337", "icon_active_color": "#185337", "content_background_color": "#FFFFFF", "content_color": "#4A5568", "content_typography_typography": "custom", "content_typography_font_family": "Inter", "content_typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "content_typography_font_weight": "400", "content_padding": {"unit": "px", "top": "0", "right": "30", "bottom": "30", "left": "30", "isLinked": false}}, "elements": [], "widgetType": "accordion"}], "isInner": true}], "isInner": true, "isLocked": true}, {"id": "58d71cb", "elType": "container", "settings": {"_title": "Tab #3", "content_width": "full", "flex_direction": "row", "flex_direction_tablet": "column", "flex_justify_content": "space-between"}, "elements": [{"id": "b864d52", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 50, "sizes": []}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_direction": "row", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "8a5d9d9", "elType": "widget", "settings": {"tabs": [{"_id": "08a36dc", "tab_title": "What is added to the water when it is acidified? What is the pH level?", "tab_content": "<p>Innovive pre-filled bottles are acidified with HCL to a pH of between 2.5 and 3.0.</p>"}], "faq_schema": "yes", "border_width": {"unit": "px", "size": 0, "sizes": []}, "border_color": "#F6F9FF", "title_background": "#FFFFFF", "title_color": "#000000", "tab_active_color": "#000000", "title_typography_typography": "custom", "title_typography_font_family": "Inter", "title_typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "title_typography_font_weight": "600", "title_padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "icon_align": "right", "icon_color": "#185337", "icon_active_color": "#185337", "content_background_color": "#FFFFFF", "content_color": "#4A5568", "content_typography_typography": "custom", "content_typography_font_family": "Inter", "content_typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "content_typography_font_weight": "400", "content_padding": {"unit": "px", "top": "0", "right": "30", "bottom": "30", "left": "30", "isLinked": false}}, "elements": [], "widgetType": "accordion"}], "isInner": true}, {"id": "91851aa", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 50, "sizes": []}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_direction": "row", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "7cc5a92", "elType": "widget", "settings": {"tabs": [{"_id": "08a36dc", "tab_title": "What is the shelf life of pre-filled water?", "tab_content": "<p>We recommend using ultra-pure pre-filled water bottles within 1 year and acidified and chlorinated pre-filled water bottles within 18 months of the fill date. The fill date can be found printed on every bottle.</p>"}], "faq_schema": "yes", "border_width": {"unit": "px", "size": 0, "sizes": []}, "border_color": "#F6F9FF", "title_background": "#FFFFFF", "title_color": "#000000", "tab_active_color": "#000000", "title_typography_typography": "custom", "title_typography_font_family": "Inter", "title_typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "title_typography_font_weight": "600", "title_padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "icon_align": "right", "icon_color": "#185337", "icon_active_color": "#185337", "content_background_color": "#FFFFFF", "content_color": "#4A5568", "content_typography_typography": "custom", "content_typography_font_family": "Inter", "content_typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "content_typography_font_weight": "400", "content_padding": {"unit": "px", "top": "0", "right": "30", "bottom": "30", "left": "30", "isLinked": false}}, "elements": [], "widgetType": "accordion"}], "isInner": true}], "isInner": true, "isLocked": true}, {"id": "0a7f031", "elType": "container", "settings": {"_title": "Tab #4", "boxed_width": {"unit": "px", "size": 1400, "sizes": []}, "flex_direction": "row", "flex_direction_tablet": "column", "flex_justify_content": "space-between"}, "elements": [{"id": "10df7ff", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 50, "sizes": []}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_direction": "row", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "3dd0ae5", "elType": "widget", "settings": {"tabs": [{"_id": "08a36dc", "tab_title": "Can the whole cage be recycled?", "tab_content": "<p>Yes \u2013 Our cage bottom, lid, water bottle, and feeders are 100% PET plastic and are free of glue or other contaminants. Innovive disposable cages are accepted where open-neck PET containers are recycled. Innovive also provides a Closed-Loop Recycling Service that makes it easy for you to recycle your used cages.</p>"}, {"tab_title": "Can Innovive help me set up a local recycling program?", "tab_content": "<p>Yes \u2013 Please provide us with the contact details for your recycling service provider. We will typically communicate with the hauler that services your site, and can send them samples and MSDS certificates when required.</p>", "_id": "410912e"}, {"tab_title": "What do I have to do to enroll in the service?", "tab_content": "<p>Email us at <a class=\"vwuw0 Xe67q\" href=\"mailto:info@innovive.com?subject=Innovive+Closed-Loop+Recycling+Service+Enrollment\" target=\"_blank\" rel=\"noopener\" data-hook=\"web-link\">info@innovive.com</a> and we will provide you with our standard recycling contract, estimated material volume and a pick-up schedule based on your current census. We can schedule the first pick up once the contract is signed.</p>", "_id": "d9ea1fa"}], "faq_schema": "yes", "border_width": {"unit": "px", "size": 0, "sizes": []}, "border_color": "#F6F9FF", "title_background": "#FFFFFF", "title_color": "#000000", "tab_active_color": "#000000", "title_typography_typography": "custom", "title_typography_font_family": "Inter", "title_typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "title_typography_font_weight": "600", "title_padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "icon_align": "right", "icon_color": "#185337", "icon_active_color": "#185337", "content_background_color": "#FFFFFF", "content_color": "#4A5568", "content_typography_typography": "custom", "content_typography_font_family": "Inter", "content_typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "content_typography_font_weight": "400", "content_padding": {"unit": "px", "top": "0", "right": "30", "bottom": "30", "left": "30", "isLinked": false}}, "elements": [], "widgetType": "accordion"}], "isInner": true}, {"id": "ec05123", "elType": "container", "settings": {"content_width": "full", "width": {"unit": "%", "size": 50, "sizes": []}, "width_tablet": {"unit": "%", "size": 100, "sizes": []}, "width_mobile": {"unit": "%", "size": "", "sizes": []}, "flex_direction": "row", "padding": {"unit": "px", "top": "0", "right": "0", "bottom": "0", "left": "0", "isLinked": true}}, "elements": [{"id": "ee6b2aa", "elType": "widget", "settings": {"tabs": [{"_id": "08a36dc", "tab_title": "What local options are available to me to recycle Innovive cages?", "tab_content": "<p>University and municipal programs are accepting an increasing range of materials. Check to see if your recycling program collects open neck plastic containers.</p>"}, {"tab_title": "How does Innovive handle cages?", "tab_content": "<p id=\"viewer-atf0a\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">Innovive handles standard category waste only.</span></p><p id=\"viewer-14c5r\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">- Cages are picked up from customer sites and sent to our recycling facility.</span></p><div id=\"viewer-2be41\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">\u00a0</span></div><p id=\"viewer-c5vhb\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">- The process is simple: cages are put through a separator that removes bedding from the cages. Cages are then flaked and granulated.</span></p><div id=\"viewer-d5p6o\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">\u00a0</span></div><p id=\"viewer-a4n85\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">- Bedding is sent to municipal composting facilities when available or sent to landfill if required.</span></p><div id=\"viewer-206r4\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">\u00a0</span></div><p id=\"viewer-efci8\" class=\"I0kxX k6as0 _1JW6K\" dir=\"auto\"><span class=\"HXJuz\">- Our clean plastic flake is sent to our vendor network for use in other products.</span></p>", "_id": "e755e8e"}], "faq_schema": "yes", "border_width": {"unit": "px", "size": 0, "sizes": []}, "border_color": "#F6F9FF", "title_background": "#FFFFFF", "title_color": "#000000", "tab_active_color": "#000000", "title_typography_typography": "custom", "title_typography_font_family": "Inter", "title_typography_font_size": {"unit": "px", "size": 18, "sizes": []}, "title_typography_font_weight": "600", "title_padding": {"unit": "px", "top": "30", "right": "30", "bottom": "30", "left": "30", "isLinked": false}, "icon_align": "right", "icon_color": "#185337", "icon_active_color": "#185337", "content_background_color": "#FFFFFF", "content_color": "#4A5568", "content_typography_typography": "custom", "content_typography_font_family": "Inter", "content_typography_font_size": {"unit": "px", "size": 16, "sizes": []}, "content_typography_font_weight": "400", "content_padding": {"unit": "px", "top": "0", "right": "30", "bottom": "30", "left": "30", "isLinked": false}}, "elements": [], "widgetType": "accordion"}], "isInner": true}], "isInner": true, "isLocked": true}]}], "isInner": true}], "isInner": false}, {"id": "fa10001", "elType": "container", "settings": {"flex_direction": "column", "boxed_width": {"unit": "px", "size": 1400, "sizes": []}, "padding": {"unit": "px", "top": "40", "right": "40", "bottom": "40", "left": "40", "isLinked": true}, "padding_tablet": {"unit": "px", "top": "40", "right": "30", "bottom": "40", "left": "30", "isLinked": false}, "padding_mobile": {"unit": "px", "top": "20", "right": "20", "bottom": "20", "left": "20", "isLinked": true}, "background_background": "classic", "background_color": "#FFFFFF"}, "elements": [{"id": "fa10002"